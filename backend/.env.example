# ---------------------------------------------------------------------------
# Supabase (service-role key: server only, never expose to the browser)
# ---------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key
SUPABASE_STORAGE_BUCKET=overlay-media

# ---------------------------------------------------------------------------
# Auth — generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ---------------------------------------------------------------------------
JWT_SECRET=change_me_to_a_random_string_of_at_least_32_characters
SESSION_TTL_HOURS=12

# ---------------------------------------------------------------------------
# HTTP
# ---------------------------------------------------------------------------
PORT=3001
NODE_ENV=development
# Allowed browser origins (comma-separated). Only these may call the API / socket.
FRONTEND_URL=http://localhost:3000
# The frontend proxies /api through its own domain, so cookies are first-party.
COOKIE_SAMESITE=lax
# Defaults to true when NODE_ENV=production
# COOKIE_SECURE=true
# Number of reverse proxies in front of the app (Netlify + Render = 2)
TRUST_PROXY_HOPS=2

# "Today" for stats / leaderboard / bulk delete
TIMEZONE=Africa/Tripoli

# ---------------------------------------------------------------------------
# Integrations
# ---------------------------------------------------------------------------
# Key for POST /api/donations/sms-auto (n8n). At least 24 characters. Empty = disabled.
SMS_AUTOMATION_KEY=
UPLOAD_MAX_MB=30
